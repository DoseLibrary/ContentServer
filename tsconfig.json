{
  "typingOptions": {
    "enableAutoDiscovery": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "dashboard"
  ],
  "compilerOptions": {
    "target": "es6", 
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true, 
    "module": "commonjs",
    "moduleResolution": "node", 
    "allowJs": true, 
    "sourceMap": true, 
    "outDir": "dist", 
    "esModuleInterop": true, 
    "forceConsistentCasingInFileNames": true, 
    "strict": true,
    "noImplicitAny": true, 
    "strictPropertyInitialization": false, 
    "skipLibCheck": true, 
    "lib": [
      "es5",
      "es6"
    ],
    "typeRoots": [
      "./src/@types/"
    ]
  },
}